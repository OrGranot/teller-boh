# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Must be a verified sender address on your Resend domain
RESEND_FROM_EMAIL=invoices@yourdomain.com

# ── AI (Anthropic) — only needed if using receipt parsing ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Webhooks ──────────────────────────────────────────────────────────────────
INVOICE_WEBHOOK_SECRET=change-me-to-a-random-secret
VOUCHER_WEBHOOK_SECRET=change-me-to-a-random-secret

# ── Deployment ────────────────────────────────────────────────────────────────
# Used for voucher QR codes — must match your production domain
NEXT_PUBLIC_APP_URL=https://yourdomain.com
